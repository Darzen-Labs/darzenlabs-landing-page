---
import Container from "../../components/container.astro";
import Label from "../../components/ui/label.astro";
import { authors } from "../../data/authors";
import { categories } from "../../data/category";
import Layout from "../../layouts/Layout.astro";
import { getFormattedDate } from "../../utils/all";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => {
  return data.draft !== true;
});

// Ordenar posts por fecha de publicación (más recientes primero)
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<Layout
  title="Blog - Darzen Labs"
  desc="Descubre artículos sobre desarrollo web, diseño y tecnología. Tutoriales, guías y las últimas tendencias del mundo digital.">
  
  <Container>
    <div class="max-w-screen-lg mx-auto">
      <!-- Header del Blog -->
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          Blog
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Descubre artículos sobre desarrollo web, diseño y tecnología. 
          Tutoriales, guías y las últimas tendencias del mundo digital.
        </p>
      </div>

      <!-- Grid de Posts -->
      <div class="grid gap-8 md:grid-cols-2">
        {sortedPosts.map((post) => {
          const author = authors.find((item) => item.slug === post.data.author);
          const category = categories.find((item) => item.slug === post.data.category);
          
          return (
            <article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300">
              {post.data.image && (
                <a href={`/blog/${post.slug}`}>
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    width="400"
                    height="240"
                    loading="lazy"
                    class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                  />
                </a>
              )}
              
              <div class="p-6">
                <div class="mb-3">
                  {category && (
                    <Label theme={category.color}>{category.title}</Label>
                  )}
                </div>
                
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 line-clamp-2">
                  <a 
                    href={`/blog/${post.slug}`}
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                  >
                    {post.data.title}
                  </a>
                </h2>
                
                <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
                  {post.data.excerpt}
                </p>
                
                <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
                  <div class="flex items-center space-x-2">
                    {author?.image && (
                      <img
                        src={author.image}
                        alt={author.name}
                        width="32"
                        height="32"
                        loading="lazy"
                        class="w-8 h-8 rounded-full object-cover"
                      />
                    )}
                    <span>{author?.name}</span>
                  </div>
                  
                  <time datetime={post.data.publishDate.toISOString()}>
                    {getFormattedDate(post.data.publishDate)}
                  </time>
                </div>
                
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-1 rounded">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {sortedPosts.length === 0 && (
        <div class="text-center py-16">
          <p class="text-gray-600 dark:text-gray-300 text-lg">
            No hay posts publicados aún. ¡Vuelve pronto para ver nuevo contenido!
          </p>
        </div>
      )}
    </div>
  </Container>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
