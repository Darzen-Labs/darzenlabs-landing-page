---
import Stars from "../backgrounds/Stars.astro"
---

<style>
  /* Contenedor principal con fondo gradiente naranja */
  .pricing-background {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, 
      #1a1a2e 0%, 
      #16213e 25%, 
      #0f3460 50%, 
      #533483 75%, 
      #7209b7 100%);
    background: linear-gradient(135deg, 
      #2d1b3d 0%, 
      #3d1e2f 25%, 
      #4a2c2a 50%, 
      #5a3921 75%, 
      #6b4423 100%);
    background: linear-gradient(135deg, 
      #1a1a1a 0%, 
      #2d1f1f 25%, 
      #3d2a1f 50%, 
      #4d3520 75%, 
      #5d4021 100%);
  }
  
  /* Tarjeta básica (Free) */
  .pricing-card-basic {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    padding: 32px;
    position: relative;
    transform: perspective(1000px) rotateY(-8deg) rotateX(5deg);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  
  /* Tarjeta PRO (destacada) */
  .pricing-card-pro {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 24px;
    padding: 32px;
    position: relative;
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(-20px) scale(1.05);
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    z-index: 2;
  }
  
  /* Tarjeta TEAM */
  .pricing-card-team {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    padding: 32px;
    position: relative;
    transform: perspective(1000px) rotateY(8deg) rotateX(5deg);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  
  /* Efectos hover */
  .pricing-card:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(-10px);
    transition: all 0.3s ease;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.15);
  }
  
  .pricing-card-pro:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) translateY(-30px) scale(1.05);
    transition: all 0.3s ease;
  }
  
  /* Iconos principales de cada tarjeta */
  .pricing-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
    border-radius: 20px;
    box-shadow: 
      0 10px 30px rgba(251, 146, 60, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  
  .pricing-icon svg {
    width: 40px;
    height: 40px;
    color: white;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }
  
  /* Icono de check personalizado */
  .check-icon {
    width: 16px;
    height: 16px;
    background: #10B981;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .check-icon svg {
    width: 10px;
    height: 10px;
    color: white;
  }

  /* Animación sutil para los iconos principales */
  .pricing-icon {
    animation: iconFloat 3s ease-in-out infinite;
  }

  @keyframes iconFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-5px); }
  }

  /* Delay diferente para cada icono */
  .pricing-card-basic .pricing-icon { animation-delay: 0s; }
  .pricing-card-pro .pricing-icon { animation-delay: -1s; }
  .pricing-card-team .pricing-icon { animation-delay: -2s; }
</style>

