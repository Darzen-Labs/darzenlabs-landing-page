---
// StarryBackground.astro
// Componente de fondo estrellado refinado para Astro con planetas opcionales

export interface Props {
  showJupiter?: boolean;
  showSaturn?: boolean;
  showMars?: boolean;
}

const { 
  showJupiter = false, 
  showSaturn = false, 
  showMars = false 
} = Astro.props;
---

<style>
  /* Contenedor principal del fondo estrellado - Naranjas más concentrados en el centro */
  .starry-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    background: 
      /* Gradientes concéntricos más intensos en el centro */
      radial-gradient(ellipse 60% 40% at 50% 50%, rgba(251, 146, 60, 0.35) 0%, rgba(249, 115, 22, 0.25) 30%, rgba(234, 88, 12, 0.15) 50%, transparent 70%),
      radial-gradient(ellipse 40% 30% at 45% 55%, rgba(249, 115, 22, 0.28) 0%, rgba(234, 88, 12, 0.18) 35%, transparent 60%),
      radial-gradient(ellipse 50% 35% at 55% 45%, rgba(234, 88, 12, 0.25) 0%, rgba(194, 65, 12, 0.15) 40%, transparent 65%),
      radial-gradient(ellipse 30% 25% at 50% 50%, rgba(194, 65, 12, 0.2) 0%, transparent 50%),
      /* Fondo base más oscuro en los bordes */
      linear-gradient(135deg, 
        rgba(15, 15, 15, 0.98) 0%, 
        rgba(25, 20, 18, 0.96) 20%, 
        rgba(35, 25, 20, 0.94) 35%, 
        rgba(45, 31, 25, 0.92) 50%, 
        rgba(35, 25, 20, 0.94) 65%, 
        rgba(25, 20, 18, 0.96) 80%, 
        rgba(15, 15, 15, 0.98) 100%);
  }
  
  /* === PLANETAS === */
  .planet {
    position: absolute;
    border-radius: 50%;
    z-index: 2;
    transition: opacity 0.3s ease;
    animation: planetFloat 8s ease-in-out infinite;
  }

  /* Planeta Júpiter - Superior izquierda */
  .planet-jupiter {
    top: 8%;
    left: 5%;
    width: 80px;
    height: 80px;
    background: 
      radial-gradient(ellipse 30% 20% at 40% 30%, rgba(255, 200, 120, 0.4) 0%, transparent 50%),
      radial-gradient(ellipse 25% 15% at 60% 70%, rgba(200, 150, 100, 0.3) 0%, transparent 40%),
      linear-gradient(45deg, 
        rgba(180, 120, 80, 0.9) 0%, 
        rgba(200, 140, 90, 0.8) 25%, 
        rgba(160, 100, 70, 0.9) 50%, 
        rgba(190, 130, 85, 0.8) 75%, 
        rgba(170, 110, 75, 0.9) 100%);
    box-shadow: 
      0 0 20px rgba(180, 120, 80, 0.3),
      inset -10px -10px 20px rgba(0, 0, 0, 0.4);
    animation-delay: 0s;
  }

  /* Planeta Saturno - Inferior derecha */
  .planet-saturn {
    bottom: 10%;
    right: 10%;
    width: 60px;
    height: 60px;
    background: 
      radial-gradient(ellipse 40% 30% at 35% 25%, rgba(255, 220, 150, 0.4) 0%, transparent 60%),
      radial-gradient(circle at 50% 50%, 
        rgba(200, 180, 120, 0.9) 0%, 
        rgba(180, 160, 100, 0.8) 40%, 
        rgba(160, 140, 80, 0.9) 100%);
    box-shadow: 
      0 0 15px rgba(200, 180, 120, 0.4),
      inset -8px -8px 15px rgba(0, 0, 0, 0.3);
    animation-delay: -3s;
  }
  /* Anillos de Saturno */
  .planet-saturn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 90px;
    height: 90px;
    border: 2px solid rgba(220, 200, 140, 0.6);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(75deg);
    box-shadow: 
      0 0 8px rgba(220, 200, 140, 0.3),
      inset 0 0 8px rgba(220, 200, 140, 0.2);
  }

  .planet-saturn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 75px;
    height: 75px;
    border: 1px solid rgba(180, 160, 100, 0.4);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(75deg);
    box-shadow: 0 0 6px rgba(180, 160, 100, 0.2);
  }

  /* Planeta Marte - Superior derecha */
  .planet-mars {
    top: 15%;
    right: 10%;
    width: 45px;
    height: 45px;
    background: 
      radial-gradient(ellipse 35% 25% at 30% 20%, rgba(255, 150, 100, 0.4) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, 
        rgba(200, 80, 60, 0.9) 0%, 
        rgba(180, 60, 40, 0.8) 50%, 
        rgba(160, 50, 30, 0.9) 100%);
    box-shadow: 
      0 0 12px rgba(200, 80, 60, 0.3),
      inset -6px -6px 12px rgba(0, 0, 0, 0.4);
    animation-delay: -5s;
  }

  /* Clases para mostrar/ocultar planetas */
  .planet-hidden {
    display: none;
  }

  /* === SISTEMA DE ESTRELLAS === */
  
  /* Estrellas circulares con brillo */
  .star {
    position: absolute;
    background: radial-gradient(circle, 
      rgba(251, 146, 60, 0.9) 0%, 
      rgba(249, 115, 22, 0.7) 40%, 
      rgba(234, 88, 12, 0.5) 70%, 
      transparent 100%);
    border-radius: 50%;
    opacity: 0;
    animation: twinkle ease-in-out infinite;
    filter: blur(0.5px);
  }

  /* Estrellas con forma de * */
  .star-shaped {
    position: absolute;
    opacity: 0;
    animation: twinkle-star ease-in-out infinite;
    color: rgba(251, 146, 60, 0.9);
    text-shadow: 
      0 0 3px rgba(251, 146, 60, 0.8),
      0 0 6px rgba(249, 115, 22, 0.6),
      0 0 9px rgba(234, 88, 12, 0.4);
    font-family: monospace;
    font-weight: bold;
    transform-origin: center;
  }

  /* Tamaños para estrellas en forma de * */
  .star-shaped-large {
    font-size: 12px;
  }

  .star-shaped-medium {
    font-size: 8px;
  }

  .star-shaped-small {
    font-size: 6px;
  }
  
  /* Estrellas grandes circulares */
  .star-large {
    width: 3px;
    height: 3px;
  }
  
  /* Estrellas medianas circulares */
  .star-medium {
    width: 2px;
    height: 2px;
  }
  
  /* Estrellas pequeñas circulares */
  .star-small {
    width: 1px;
    height: 1px;
  }
  
  /* Posicionamiento de estrellas grandes (circulares) */
  .star-1 {
    top: 15%;
    left: 8%;
    animation-duration: 4s;
    animation-delay: 0s;
  }
  
  .star-2 {
    top: 25%;
    left: 85%;
    animation-duration: 3.5s;
    animation-delay: -1.2s;
  }
  
  .star-3 {
    top: 70%;
    left: 18%;
    animation-duration: 4.2s;
    animation-delay: -3.1s;
  }
  
  .star-4 {
    top: 80%;
    left: 78%;
    animation-duration: 3.3s;
    animation-delay: -1.8s;
  }
  
  /* Posicionamiento de estrellas medianas (circulares) */
  .star-5 {
    top: 35%;
    left: 65%;
    animation-duration: 4.5s;
    animation-delay: -0.8s;
  }
  
  .star-6 {
    top: 50%;
    left: 25%;
    animation-duration: 3.1s;
    animation-delay: -3.5s;
  }
  
  .star-7 {
    top: 75%;
    left: 40%;
    animation-duration: 3.6s;
    animation-delay: -2.9s;
  }
  
  .star-8 {
    top: 85%;
    left: 88%;
    animation-duration: 4.1s;
    animation-delay: -0.3s;
  }
  
  /* Posicionamiento de estrellas pequeñas (circulares) */
  .star-9 {
    top: 18%;
    left: 22%;
    animation-duration: 2.8s;
    animation-delay: -1.7s;
  }
  
  .star-10 {
    top: 28%;
    left: 48%;
    animation-duration: 3.2s;
    animation-delay: -2.4s;
  }
  
  .star-11 {
    top: 58%;
    left: 68%;
    animation-duration: 2.7s;
    animation-delay: -1.1s;
  }
  
  .star-12 {
    top: 88%;
    left: 15%;
    animation-duration: 3.8s;
    animation-delay: -3.7s;
  }

  /* Posicionamiento de estrellas con forma de * grandes */
  .star-shaped-1 {
    top: 40%;
    left: 12%;
    animation-duration: 5s;
    animation-delay: -2.8s;
  }

  .star-shaped-2 {
    top: 55%;
    left: 92%;
    animation-duration: 3.8s;
    animation-delay: -0.5s;
  }

  .star-shaped-3 {
    top: 20%;
    left: 35%;
    animation-duration: 3.7s;
    animation-delay: -2.2s;
  }

  .star-shaped-4 {
    top: 65%;
    left: 55%;
    animation-duration: 4.8s;
    animation-delay: -1.5s;
  }

  /* Posicionamiento de estrellas con forma de * medianas */
  .star-shaped-5 {
    top: 38%;
    left: 72%;
    animation-duration: 2.5s;
    animation-delay: -0.9s;
  }

  .star-shaped-6 {
    top: 48%;
    left: 38%;
    animation-duration: 3.9s;
    animation-delay: -3.3s;
  }

  .star-shaped-7 {
    top: 68%;
    left: 32%;
    animation-duration: 3.4s;
    animation-delay: -2.6s;
  }

  /* Posicionamiento de estrellas con forma de * pequeñas */
  .star-shaped-8 {
    top: 78%;
    left: 58%;
    animation-duration: 2.9s;
    animation-delay: -0.6s;
  }

  .star-shaped-9 {
    top: 12%;
    left: 60%;
    animation-duration: 4.3s;
    animation-delay: -1.9s;
  }

  .star-shaped-10 {
    top: 45%;
    left: 82%;
    animation-duration: 3.1s;
    animation-delay: -2.7s;
  }
  
  /* === ANIMACIONES === */
  
  /* Animación de parpadeo para estrellas circulares */
  @keyframes twinkle {
    0%, 100% {
      opacity: 0;
      transform: scale(0.8);
      filter: blur(0.5px);
    }
    25% {
      opacity: 0.3;
      transform: scale(1);
      filter: blur(0.3px);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
      filter: blur(0.1px);
    }
    75% {
      opacity: 0.6;
      transform: scale(1.1);
      filter: blur(0.2px);
    }
  }

  /* Animación especial para estrellas con forma de * */
  @keyframes twinkle-star {
    0%, 100% {
      opacity: 0;
      transform: scale(0.5) rotate(0deg);
      text-shadow: 
        0 0 2px rgba(251, 146, 60, 0.4),
        0 0 4px rgba(249, 115, 22, 0.3),
        0 0 6px rgba(234, 88, 12, 0.2);
    }
    25% {
      opacity: 0.4;
      transform: scale(0.8) rotate(45deg);
      text-shadow: 
        0 0 4px rgba(251, 146, 60, 0.6),
        0 0 8px rgba(249, 115, 22, 0.4),
        0 0 12px rgba(234, 88, 12, 0.3);
    }
    50% {
      opacity: 1;
      transform: scale(1.3) rotate(90deg);
      text-shadow: 
        0 0 6px rgba(251, 146, 60, 0.9),
        0 0 12px rgba(249, 115, 22, 0.7),
        0 0 18px rgba(234, 88, 12, 0.5);
    }
    75% {
      opacity: 0.7;
      transform: scale(1.1) rotate(135deg);
      text-shadow: 
        0 0 5px rgba(251, 146, 60, 0.7),
        0 0 10px rgba(249, 115, 22, 0.5),
        0 0 15px rgba(234, 88, 12, 0.4);
    }
  }

  /* Animación de flotación para planetas */
  @keyframes planetFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-3px) rotate(1deg);
    }
    50% {
      transform: translateY(-6px) rotate(0deg);
    }
    75% {
      transform: translateY(-3px) rotate(-1deg);
    }
  }

  /* Efectos adicionales para crear más profundidad */
  .starry-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse 80% 60% at 50% 50%, transparent 0%, rgba(0, 0, 0, 0.3) 80%);
    pointer-events: none;
  }
</style>

<div class="starry-container">
    <!-- Planetas (condicionales) -->
    {showJupiter && <div class="planet planet-jupiter"></div>}
    {showSaturn && <div class="planet planet-saturn"></div>}
    {showMars && <div class="planet planet-mars"></div>}

    <!-- Estrellas grandes circulares -->
    <div class="star star-large star-1"></div>
    <div class="star star-large star-2"></div>
    <div class="star star-large star-3"></div>
    <div class="star star-large star-4"></div>
    
    <!-- Estrellas medianas circulares -->
    <div class="star star-medium star-5"></div>
    <div class="star star-medium star-6"></div>
    <div class="star star-medium star-7"></div>
    <div class="star star-medium star-8"></div>
    
    <!-- Estrellas pequeñas circulares -->
    <div class="star star-small star-9"></div>
    <div class="star star-small star-10"></div>
    <div class="star star-small star-11"></div>
    <div class="star star-small star-12"></div>

    <!-- Estrellas grandes con forma de * -->
    <div class="star-shaped star-shaped-large star-shaped-1">*</div>
    <div class="star-shaped star-shaped-large star-shaped-2">*</div>
    <div class="star-shaped star-shaped-large star-shaped-3">*</div>
    <div class="star-shaped star-shaped-large star-shaped-4">*</div>

    <!-- Estrellas medianas con forma de * -->
    <div class="star-shaped star-shaped-medium star-shaped-5">*</div>
    <div class="star-shaped star-shaped-medium star-shaped-6">*</div>
    <div class="star-shaped star-shaped-medium star-shaped-7">*</div>

    <!-- Estrellas pequeñas con forma de * -->
    <div class="star-shaped star-shaped-small star-shaped-8">*</div>
    <div class="star-shaped star-shaped-small star-shaped-9">*</div>
    <div class="star-shaped star-shaped-small star-shaped-10">*</div>
</div>